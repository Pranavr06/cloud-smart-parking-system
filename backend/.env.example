# Server Configuration
PORT=5000
NODE_ENV=development

# Database Mode
# Set to 'aws' to connect to real AWS DynamoDB
# Set to 'local' for local development (uses local persistent JSON file / in-memory store mirroring DynamoDB)
# Set to 'dynamodb-local' if running DynamoDB Local Docker container (endpoint: http://localhost:8000)
DB_MODE=local

# AWS Configuration (Fargate task role supplies credentials in AWS deployments)
AWS_REGION=us-east-1
# Do not put long-lived AWS credentials in this file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB Table Names
DYNAMODB_TABLE_PARKING_SLOTS=ParkingSlots
DYNAMODB_TABLE_BOOKINGS=Bookings
DYNAMODB_TABLE_DETECTION_HISTORY=DetectionHistory

# DynamoDB Local Endpoint (if DB_MODE=dynamodb-local)
DYNAMODB_ENDPOINT=http://localhost:8000

# Authentication: use AUTH_MODE=cognito in production; local is development only.
AUTH_MODE=local
DEPLOYMENT_MODE=local
LOCAL_SESSION_SECRET=
LOCAL_ADMIN_EMAILS=
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Server-to-server detection ingestion. Generate with: openssl rand -hex 32
DETECTION_API_KEY=

# Simulation Settings
SIMULATION_INTERVAL_MS=5000
